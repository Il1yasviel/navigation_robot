<?xml version="1.0"?>
<package format="3">
  <name>navigation_robot_bringup</name>
  <version>0.1.0</version>
  <description>Single configuration and mode-selecting launch entry for navigation_robot.</description>
  <maintainer email="air@localhost.local">air</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>navigation_robot_base_driver</exec_depend>
  <exec_depend>navigation_robot_description</exec_depend>
  <exec_depend>navigation_robot_lidar_driver</exec_depend>
  <exec_depend>navigation_robot_navigation</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
